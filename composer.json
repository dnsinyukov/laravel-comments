{
    "name": "coderden/laravel-comments",
    "description": "A comprehensive comment system for Laravel with replies, likes, and abuse reporting",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "comments",
        "replies",
        "likes",
        "moderation"
    ],
    "authors": [
        {
            "name": "Coderden Team",
            "email": "dnsinyukov@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/framework": "^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "orchestra/testbench": "^7.0|^8.0",
        "fakerphp/faker": "^1.9",
        "mockery/mockery": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Coderden\\Comments\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Coderden\\Comments\\Providers\\CommentsServiceProvider"
            ],
            "aliases": {
                "Comments": "Coderden\\Comments\\Facades\\Comments"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    }
}